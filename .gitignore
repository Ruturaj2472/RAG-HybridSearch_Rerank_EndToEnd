# ==========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ==========================
# Virtual environments
# ==========================
venv/
.venv/
env/
ENV/
env.bak/
